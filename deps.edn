{;; Terms for the whole repo; LICENSE is the authority and this is the pointer.
 ;; deps.edn has no official slot for it — the Clojure CLI reads the keys it
 ;; knows and ignores the rest — so the shape is Leiningen's :license, which is
 ;; where both tooling and people already look for a project's terms.
 :license {:name "MIT" :url "https://opensource.org/license/mit"}

 ;; JVM Clojure classpath for the book build only. The tool itself runs on
 ;; babashka (see bb.edn); this file exists so Clay can evaluate the book's
 ;; example namespaces against the real claimgraph source.
 :paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        babashka/fs         {:mvn/version "0.5.34"}
        babashka/process    {:mvn/version "0.6.25"}
        org.babashka/cli    {:mvn/version "0.12.76"}
        cheshire/cheshire   {:mvn/version "6.2.0"}
        ;; bb bundles edamame; the JVM book build needs it explicitly (the
        ;; audit chapter loads claimgraph.audit -> ingest.clj-code)
        borkdude/edamame    {:mvn/version "1.4.32"}}
 :aliases
 {:book {:extra-deps  {org.scicloj/clay {:mvn/version "2.0.16"}}
         :extra-paths ["book"]
         :exec-fn     render/build!}
  :book-preview {:extra-deps  {org.scicloj/clay {:mvn/version "2.0.16"}}
                 :extra-paths ["book"]
                 :exec-fn     render/preview!}}}
