{:paths ["src" "resources" "test" "bench"]
 ;; The floor scripts/setup.sh reads out of this file and refuses to install
 ;; below, so an overridden BB_VERSION cannot hand the project a bb it rejects.
 ;; bb warns on every invocation under this version, naming the version wanted
 ;; — the alternative is a stale bb failing much later, as a missing var deep
 ;; inside a task.
 :min-bb-version "1.12.218"
 :tasks
 {test     {:doc  "Run the test suite against both stores"
            :task (do (require '[claimgraph.run-tests])
                      ((resolve 'claimgraph.run-tests/-main)))}
  bench    {:doc  "Run the memory benchmark (bb bench = deterministic mechanics; bb bench llm = LLM quality layer)"
            :task (apply (requiring-resolve 'claimgraph.bench/-main) *command-line-args*)}
  claim    {:doc  "Run the claimgraph CLI (bb run claim -- <args>)"
            :task (apply (requiring-resolve 'claimgraph.cli/-main) *command-line-args*)}
  book     {:doc  "Build the book: Clay evaluates book/chapters/ against src/, Quarto renders to book/rendered/_book. Needs a JVM and the quarto CLI."
            :task (clojure "-X:book")}
  book:preview {:doc  "Build the book, then serve it with quarto preview"
                :task (clojure "-X:book-preview")}}}
